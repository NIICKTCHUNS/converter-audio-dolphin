#!/usr/bin/env bash

mode="$1"
shift

for f in "$@"; do
    [ -f "$f" ] || continue

    # Obter duração total do vídeo
    duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$f")
    total_sec="${duration%.*}"

    # Garante que total_sec seja estritamente um número válido
    if ! [[ "$total_sec" =~ ^[0-9]+$ ]] || [ "$total_sec" -le 0 ]; then
        total_sec=1
    fi

    base=$(basename "$f")
    filename_noext="${f%.*}"
    ext="${f##*.}"

    case "$mode" in
        "extract-mp3")
            output="${filename_noext}.mp3"
            ffmpeg_args=(-i "$f" -vn -c:a libmp3lame -q:a 0 -y)
            label="Extraindo MP3 de:\n$base"
            ;;
        "extract-wav")
            output="${filename_noext}.wav"
            ffmpeg_args=(-i "$f" -vn -c:a pcm_s16le -y)
            label="Extraindo WAV Lossless de:\n$base"
            ;;
        "embed-mp3")
            output="${filename_noext}_mp3.${ext}"
            ffmpeg_args=(-i "$f" -c:v copy -c:a libmp3lame -q:a 0 -y)
            label="Convertendo áudio do vídeo para MP3:\n$base"
            ;;
        "embed-pcm")
            output="${filename_noext}_pcm.${ext}"
            ffmpeg_args=(-i "$f" -c:v copy -c:a pcm_s16le -y)
            label="Convertendo áudio do vídeo para PCM:\n$base"
            ;;
        *)
            exit 1
            ;;
    esac

    # Criar a barra de progresso no Kdialog
    dbusRef=$(kdialog --title "Extraindo/Convertendo Áudio" --icon new-audio-alarm --progressbar "$label" 100)

    # Executar o ffmpeg monitorando o progresso via D-Bus
    ffmpeg "${ffmpeg_args[@]}" -progress pipe:1 "$output" 2>/dev/null | while read -r line; do
        if [[ "$line" =~ out_time_ms=([0-9]+) ]]; then
            us="${BASH_REMATCH[1]}"
            cur_sec=$((us / 1000000))
            percent=$((cur_sec * 100 / total_sec))
            [ $percent -gt 100 ] && percent=100

            # Cancela o ffmpeg se o usuário fechar a janela do kdialog
            if ! qdbus $dbusRef Set "" value $percent 2>/dev/null; then
                pkill -P $$ ffmpeg 2>/dev/null
                break
            fi
        fi
    done

    qdbus $dbusRef close 2>/dev/null
done
