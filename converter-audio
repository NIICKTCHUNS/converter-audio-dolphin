#!/usr/bin/env bash

format="$1"
shift

for f in "$@"; do
    # Obter duração total do vídeo
    duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$f")
    total_sec=${duration%.*}

    if [ -z "$total_sec" ] || [ "$total_sec" -le 0 ]; then
        total_sec=1
    fi

    # Configurar parâmetros do ffmpeg por formato
    if [ "$format" = "mp3" ]; then
        ffmpeg_opts=(-q:a 0 -map a)
        label="MP3"
    else
        ffmpeg_opts=(-vn -c:a pcm_s16le)
        label="WAV Lossless"
    fi

    # Abrir a janela de progresso
    dbusRef=$(kdialog --title "Conversor de Áudio" --progressbar "Extraindo $label de:\n$(basename "$f")" 100)

    # Executar o ffmpeg e atualizar a barra
    ffmpeg -i "$f" "${ffmpeg_opts[@]}" -y -progress pipe:1 "${f%.*}.${format}" 2>/dev/null | while read -r line; do
        if [[ "$line" =~ out_time_ms=([0-9]+) ]]; then
            us="${BASH_REMATCH[1]}"
            cur_sec=$((us / 1000000))
            percent=$((cur_sec * 100 / total_sec))
            [ $percent -gt 100 ] && percent=100
            qdbus $dbusRef Set "" value $percent 2>/dev/null
        fi
    done

    qdbus $dbusRef close 2>/dev/null
done
